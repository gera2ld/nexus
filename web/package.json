{
  "name": "nexus-web",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "openapi-typescript ../api/openapi.json -o src/api/schema.d.ts",
    "dev": "npm run gen && vite",
    "build": "npm run gen && tsc -b && vite build",
    "typecheck": "npm run gen && tsc -b",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "check": "npm run typecheck && npm run lint && oxfmt --check"
  },
  "dependencies": {
    "@tanstack/react-query": "5.108.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.5.2",
    "lucide-react": "1.77.0",
    "monaco-editor": "0.57.0",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "openapi-typescript": "7.13.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
