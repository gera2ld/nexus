                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Delete a address book and everything in it",
        "tags": [
          "address books"
        ]
      },
      "get": {
        "operationId": "get-addressbook",
        "parameters": [
          {
            "in": "path",
