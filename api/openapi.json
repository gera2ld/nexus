            "items": {
              "enum": [
                "VEVENT",
                "VTODO"
              ],
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "description": {
            "maxLength": 2000,
            "type": "string"
          },
          "name": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "CreatePasswordInputBody": {
        "additionalProperties": false,
