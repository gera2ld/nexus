      "AppPassword": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "/api/nexus/schemas/AppPassword.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "created": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "lastUsedAt": {
            "type": "string"
          },
          "paths": {
            "description": "Path limits; empty means none",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "revokedAt": {
            "type": "string"
          },
          "scopes": {
            "items": {
              "enum": [
                "cal",
                "card",
                "files"
              ],
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "secret": {
            "description": "Only in the create response; shown once",
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "scopes",
          "paths",
          "created",
          "lastUsedAt",
          "revokedAt"
        ],
        "type": "object"
      },
      "Collection": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "/api/nexus/schemas/Collection.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "color": {
            "description": "Calendars only: #rrggbb or #rrggbbaa",
            "type": "string"
          },
          "components": {
            "description": "Calendars only: what it holds",
            "items": {
              "enum": [
                "VEVENT",
                "VTODO"
              ],
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "description": {
            "type": "string"
          },
          "items": {
            "description": "Events and tasks, or contacts",
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "description": "URL name, fixed at creation",
            "type": "string"
          },
          "url": {
            "description": "The collection's DAV address",
            "type": "string"
          }
        },
        "required": [
          "slug",
          "name",
          "description",
          "items",
          "url"
        ],
        "type": "object"
      },
      "CreateAddressbookInputBody": {
        "additionalProperties": false,
